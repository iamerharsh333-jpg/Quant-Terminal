# QUANT TERMINAL - Environment Configuration Example
# Copy this file to .env and fill in your optional API keys.
# Quant Terminal operates 100% offline in Demo Mode without any API keys.

# Data Provider Configuration
DEFAULT_DATA_MODE=demo  # Options: demo, historical, api

# Optional Future Market Data Vendor Credentials (Leave blank if not using)
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
TIINGO_API_KEY=
ZERODHA_API_KEY=

# Server & Deployment Configuration
PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

